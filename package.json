{
  "name": "dsh-knowledge-recall",
  "description": "weaver 知识自动召回：真实用户消息回合首步检索本地知识库并注入相关条目摘要（命中才注入、预算可控、主/子代理通吃）",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "default": "./src/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-alpha.0 <1.0.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-alpha.0 <1.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build:client": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "weaver",
    "knowledge"
  ]
}